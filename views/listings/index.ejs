<% layout("layouts/boilerplate") %>
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .filter {
            text-align: center;
            margin-right: 2rem;
            margin-top: 2rem;
            opacity: 0.5;
        }

        .filter:hover {
            opacity: 1;
            cursor: pointer;
        }

        .filter p {
            font-size: 0.8rem;
        }

        .tax-info {
            display: none;
        }

        .text-toggle {
            border: 1px solid black;
            border-radius: 1rem;
            height: 3.3rem;
            margin-left: 2rem;
            padding: 1rem;
            display: flex;
            align-items: center;

        }
    </style>
    <div id="filters">
        <div class="filter">
            <div class="div"><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic Cities</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-solid fa-mountain"></i></div>
            <p>mountain</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amaizing pools</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-solid fa-campground"></i></div>
            <p>Capming</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </div>

        <div class="filter">
            <div class="div"><i class="fa-solid fa-cloud-rain"></i></div>
            <p>Rainy</p>
        </div>
        <div class="filter">
            <div class="div"><i class="fa-solid fa-tree"></i></div>
            <p>Forest</p>
        </div>
        <div class="text-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>
    <div class="row row-cols-lg-4 row-cols-md-3 mt-3 row-cols-sm-1 ">
        <% for(let listing of allListing){ %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image?.url %>" class="card-img-top" alt="listing_imag" style="height: 20rem">
                    <div class="card-img-overlay">abc</div>


                    <div class=" card-body">
                        <p class="card-text">
                            <b>
                                <%= listing.title %>
                            </b>
                            <br>
                            PKR <%= listing.price.toLocaleString("en-PK") %>/night
                                <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
            <% } %>
    </div>
    <!-- <ul>

                    <% for(let listing of allListing){ %>
                        <li><a href="/listings/<%=listing._id %>">
                                <%= listing.title %>
                            </a>

                        </li>

                        <% } %>
                </ul> -->
    <script>
        let taxSwitch = document.getElementById("switchCheckDefault");
        taxSwitch.addEventListener("click", () => {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (info of taxInfo) {
                if (info.style.display != "inline") {
                    info.style.display = "inline"
                } else {
                    info.style.display = "none";
                }

            }
        });

    </script>